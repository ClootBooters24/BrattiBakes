{
    "name": "brattibakes",
    "compatibility_date": "2026-11-23",
    "main": "./worker.js",
    "assets": {
        "directory": "./",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/images/*"]
    },
    "r2_buckets": [
        { "binding": "GALLERY_BUCKET", "bucket_name": "brattibakes-r2" }
    ]
}